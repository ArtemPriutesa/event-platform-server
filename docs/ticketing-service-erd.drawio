<mxfile host="app.diagrams.net" type="device">
  <diagram id="ticketing-erd" name="Ticketing">
    <mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Ticketing — PostgreSQL / EF Core model" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="ticket-types" value="&lt;b&gt;ticket_types&lt;/b&gt;&lt;hr&gt;PK id BIGINT IDENTITY&lt;br&gt;event_public_id UUID (external)&lt;br&gt;event_title_snapshot, name&lt;br&gt;price, currency&lt;br&gt;total / reserved / sold_quantity&lt;br&gt;UQ event_public_id + name&lt;br&gt;version BIGINT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="reservations" value="&lt;b&gt;reservations&lt;/b&gt;&lt;hr&gt;PK id BIGINT IDENTITY&lt;br&gt;UQ public_id UUID&lt;br&gt;user_public_id UUID (external)&lt;br&gt;status, expires_at&lt;br&gt;created_at / is_deleted / version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="reservation-details" value="&lt;b&gt;reservation_details&lt;/b&gt;&lt;hr&gt;PK, FK reservation_id&lt;br&gt;contact_name_snapshot&lt;br&gt;contact_email_snapshot&lt;br&gt;notes&lt;br&gt;created_at / is_deleted / version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="440" y="430" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="reservation-items" value="&lt;b&gt;reservation_items&lt;/b&gt;&lt;hr&gt;PK id BIGINT IDENTITY&lt;br&gt;FK reservation_id, ticket_type_id&lt;br&gt;event_public_id (external)&lt;br&gt;event_title_snapshot&lt;br&gt;ticket_type_name_snapshot&lt;br&gt;unit_price, quantity&lt;br&gt;UQ reservation_id + ticket_type_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4F7;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="830" y="180" width="320" height="210" as="geometry"/></mxCell>
        <mxCell id="tickets" value="&lt;b&gt;tickets&lt;/b&gt;&lt;hr&gt;PK id BIGINT IDENTITY&lt;br&gt;UQ public_id UUID (QR identity)&lt;br&gt;FK reservation_item_id + ticket_type_id&lt;br&gt;status, issued_at, used_at&lt;br&gt;created_at / is_deleted / version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="830" y="450" width="320" height="170" as="geometry"/></mxCell>
        <mxCell id="tickettypes-items" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#176B87;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ticket-types" target="reservation-items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="reservations-items" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#176B87;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="reservations" target="reservation-items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="reservations-details" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#176B87;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERone;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="reservations" target="reservation-details"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="items-tickets" value="1 : N (one ticket per unit)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#176B87;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="reservation-items" target="tickets"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="event-ref" value="Event Catalog: events.public_id" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#F3F6FA;strokeColor=#7A8793;dashed=1;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="note" value="M:N reservations ↔ ticket_types через reservation_items. event_public_id і user_public_id — зовнішні посилання, не SQL FK. unit_price і назви — незмінні знімки при оформленні." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#FFF8E1;strokeColor=#D6A84F;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="650" width="710" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

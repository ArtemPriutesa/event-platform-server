<mxfile host="app.diagrams.net" type="device">
  <diagram id="payments-feedback-model" name="Payments and Feedback">
    <mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Payments &amp; Feedback — MongoDB collections" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="750" height="40" as="geometry"/></mxCell>
        <mxCell id="payments" value="&lt;b&gt;payments&lt;/b&gt;&lt;hr&gt;_id&lt;br&gt;reservationPublicId (unique reference)&lt;br&gt;userPublicId&lt;br&gt;amount, currency, status&lt;br&gt;providerPaymentId&lt;br&gt;eventTitleSnapshot (optional)&lt;br&gt;createdAt, updatedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="320" height="190" as="geometry"/></mxCell>
        <mxCell id="notifications" value="&lt;b&gt;notifications&lt;/b&gt;&lt;hr&gt;_id&lt;br&gt;userPublicId&lt;br&gt;type, title, message&lt;br&gt;event { eventPublicId, title, startsAt } embedded&lt;br&gt;readAt, createdAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="490" y="140" width="340" height="170" as="geometry"/></mxCell>
        <mxCell id="reviews" value="&lt;b&gt;reviews&lt;/b&gt;&lt;hr&gt;_id&lt;br&gt;eventPublicId + eventTitleSnapshot&lt;br&gt;ticketPublicId (unique reference)&lt;br&gt;userPublicId&lt;br&gt;author { displayName, avatarUrl } embedded&lt;br&gt;rating, text, photos?&lt;br&gt;comments[] embedded; discussionId reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="930" y="120" width="330" height="240" as="geometry"/></mxCell>
        <mxCell id="discussions" value="&lt;b&gt;discussions&lt;/b&gt;&lt;hr&gt;_id (one message per document)&lt;br&gt;reviewId, discussionId references&lt;br&gt;author { userPublicId, displayName } embedded&lt;br&gt;text, attachments?&lt;br&gt;createdAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4F7;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="930" y="450" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="ticketing" value="Ticketing DB&#xa;Reservation.PublicId / Ticket.PublicId" style="shape=rect;whiteSpace=wrap;html=1;rounded=1;fillColor=#F3F6FA;strokeColor=#7A8793;dashed=1;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="480" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="catalog" value="Event Catalog DB&#xa;Event.PublicId / Title" style="shape=rect;whiteSpace=wrap;html=1;rounded=1;fillColor=#F3F6FA;strokeColor=#7A8793;dashed=1;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="480" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="payment-reservation" value="reservationPublicId reference" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#7A8793;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ticketing" target="payments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="review-ticket" value="ticketPublicId reference" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#7A8793;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ticketing" target="reviews"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="review-event" value="eventPublicId reference; title snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#7A8793;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="catalog" target="reviews"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="event-notification" value="event snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#7A8793;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="catalog" target="notifications"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="review-discussion" value="discussionId reference" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#176B87;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="reviews" target="discussions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Пунктирні зв’язки — зовнішні UUID-посилання, не FK. Embedded: автор, event snapshot і короткі коментарі. Referencing: бронювання, квиток і довга дискусія. Опційні photos/attachments демонструють документи різної структури." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#FFF8E1;strokeColor=#D6A84F;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="620" width="780" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

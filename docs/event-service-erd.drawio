<mxfile host="app.diagrams.net" type="device">
  <diagram id="event-catalog-erd" name="Event Catalog">
    <mxGraphModel dx="1350" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Event Catalog — PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="organizers" value="&lt;b&gt;organizers&lt;/b&gt;&lt;hr&gt;PK id BIGINT IDENTITY&lt;br&gt;name VARCHAR(200)&lt;br&gt;UQ email&lt;br&gt;created_at / is_deleted / version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="categories" value="&lt;b&gt;categories&lt;/b&gt;&lt;hr&gt;PK id BIGINT IDENTITY&lt;br&gt;UQ name&lt;br&gt;description&lt;br&gt;created_at / is_deleted / version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="370" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="events" value="&lt;b&gt;events&lt;/b&gt;&lt;hr&gt;PK id BIGINT IDENTITY&lt;br&gt;UQ public_id UUID&lt;br&gt;FK organizer_id, category_id&lt;br&gt;title, description&lt;br&gt;starts_at, ends_at, status&lt;br&gt;created_at / is_deleted / version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="400" y="180" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="venues" value="&lt;b&gt;event_venues&lt;/b&gt;&lt;hr&gt;PK, FK event_id&lt;br&gt;venue_name, address&lt;br&gt;city, country, capacity&lt;br&gt;created_at / is_deleted / version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="tags" value="&lt;b&gt;tags&lt;/b&gt;&lt;hr&gt;PK id BIGINT IDENTITY&lt;br&gt;UQ name&lt;br&gt;created_at / is_deleted / version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="820" y="430" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="event-tags" value="&lt;b&gt;event_tags&lt;/b&gt;&lt;hr&gt;PK, FK event_id&lt;br&gt;PK, FK tag_id&lt;br&gt;added_at, added_by&lt;br&gt;created_at / is_deleted / version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4F7;strokeColor=#176B87;strokeWidth=2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="470" y="450" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="organizer-event" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#176B87;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="organizers" target="events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="category-event" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#176B87;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="categories" target="events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="event-venue" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#176B87;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERone;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="events" target="venues"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="event-eventtag" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#176B87;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="events" target="event-tags"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="tag-eventtag" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#176B87;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tags" target="event-tags"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="event_tags реалізує M:N events ↔ tags. public_id — зовнішній UUID, який Ticketing/Payments зберігають без міжбазового FK." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#FFF8E1;strokeColor=#D6A84F;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="580" width="300" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
